{
  "id": "quest_pro",
  "name": "Meta Quest Pro (Default)",
  "category": "vr_headset",
  "display": {
    "panel": "1800x1920 per eye QLED",
    "refresh_rate_hz": 72,
    "local_dimming": true,
    "eye_tracking": true
  },
  "odt_settings": {
    "pixels_per_display_pixel": 1.25,
    "encode_resolution_width": 3600,
    "encode_bitrate_mbps": 400,
    "fov_tangent_multiplier": [0.80, 0.74],
    "asw_mode": 0
  },
  "ofxr_bridge": {
    "enabled": true,
    "target_fps": 72,
    "optical_flow_mode": "fast_low_vram",
    "overlay": "off"
  },
  "xp_vr_overrides": {
    "_vr_separate_graphics_settings": 1,
    "_vr_vrs_enable": 0,
    "_vr_depth_reprojection": 1,
    "_rcas_ratio": 0.75,
    "vr_renopt_FSR_04": 0,
    "vr_renopt_FXAA": 0,
    "vr_renopt_ANISO": 16
  }
}
